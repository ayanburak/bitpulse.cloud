{
  "name": "bitpulse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/render.tsx --outDir .ssr && node scripts/prerender.ts && pagefind --site dist --silent",
    "preview": "node scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "design-hash": "node scripts/design-hash.ts",
    "social": "node scripts/social.ts",
    "video-scan": "node scripts/video-scan.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "image-size": "2.0.4",
    "marked": "18.1.2",
    "pagefind": "1.5.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
